{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"],
      // Typecheck the workspace packages from SOURCE, not from their build
      // output. Their package.json points `types` at ./dist/index.d.ts, which
      // is gitignored, so a fresh checkout could not typecheck until a bundler
      // had run first — and `bun run build:packages` is a ~1GB, multi-minute
      // vite build. Three agents doing that at once on this box put the load
      // at 44 with 24% iowait and no forward progress.
      //
      // Nothing about what ships changes here. Vite still resolves the real
      // package at build time; this only tells tsc where the types live.
      "@omg-dev/client": ["../packages/client/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"],
  // Tests run under `bun test` from the repo root, which supplies the bun:test
  // types. The app build has no bun typings, so exclude them here.
  //
  // `*.release-check.ts` is the same thing under a name `bun test` does not
  // auto-discover, so that the 1.7 GB dist-lib build it needs stays off the
  // default test path. It also imports ../dist-lib, a build output that does
  // not exist in a clean checkout. Both reasons keep it out of this program.
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.release-check.ts"
  ]
}

{
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "@omg-dev/connectors": ["./packages/connectors/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "scripts-internal/**/*.ts", "deploy/**/*.ts"],
  "exclude": ["web", "node_modules"]
}

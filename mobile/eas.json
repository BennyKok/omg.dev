{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      // Google iOS OAuth client (public identifier, not a secret). app.config.js
      // registers the Google Sign-In plugin and reversed URL scheme only when
      // this is set, and the Google button renders only when it is set.
      "env": {
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "470443022473-sj262et812jqi3pvl05ccr8spuq2th45.apps.googleusercontent.com"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "development"
    },
    // A dev client for the iOS Simulator, so UI work can be seen and
    // screenshotted without a device or a TestFlight round trip. Needs no
    // signing (simulator builds are unsigned), and `developmentClient` is what
    // lets it load JS from a Metro tunnel — so once installed, every JS change
    // is a reload rather than a rebuild.
    "simulator": {
      // Google iOS OAuth client (public identifier, not a secret). app.config.js
      // registers the Google Sign-In plugin and reversed URL scheme only when
      // this is set, and the Google button renders only when it is set.
      "env": {
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "470443022473-sj262et812jqi3pvl05ccr8spuq2th45.apps.googleusercontent.com"
      },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "development"
    },
    "preview": {
      // Google iOS OAuth client (public identifier, not a secret). app.config.js
      // registers the Google Sign-In plugin and reversed URL scheme only when
      // this is set, and the Google button renders only when it is set.
      "env": {
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "470443022473-sj262et812jqi3pvl05ccr8spuq2th45.apps.googleusercontent.com"
      },
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "preview"
    },
    "production": {
      // Google iOS OAuth client (public identifier, not a secret). app.config.js
      // registers the Google Sign-In plugin and reversed URL scheme only when
      // this is set, and the Google button renders only when it is set.
      "env": {
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "470443022473-sj262et812jqi3pvl05ccr8spuq2th45.apps.googleusercontent.com"
      },
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "2T82F3J732",
        // The App Store Connect app, created by the first submission. Without
        // it eas submit can only resolve the app by asking, so a
        // --non-interactive run dies with "Set ascAppId in the submit profile"
        // AFTER the build has already been queued — which is a confusing way
        // to lose a submission.
        "ascAppId": "6800792515",
        // Used only if the record ever has to be recreated. App Store Connect
        // names are unique across the whole store, so "omg" was never free.
        // This is listing metadata; the home-screen label is app.json's `name`
        // and is baked into the binary.
        "appName": "omg.dev",
        "language": "en-US"
      }
    }
  }
}
